{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*get_ad_performance$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/capture_ad_performance.py\"",
            "timeout": 30,
            "statusMessage": "큰 성과 응답을 파일로 저장 중"
          }
        ]
      },
      {
        "matcher": ".*list_campaign_change_raw$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/capture_change_raw.py\"",
            "timeout": 30,
            "statusMessage": "변경 이력 응답을 파일로 저장 중"
          }
        ]
      },
      {
        "matcher": ".*(get_ad_performance|get_target_progress_v2|list_promotions|list_campaign_change_raw|get_external_context)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/save_responses.py\"",
            "timeout": 30,
            "statusMessage": "보고서용 응답 원본 저장 중"
          }
        ]
      }
    ]
  }
}
